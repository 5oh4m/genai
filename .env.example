# ============================================================
# AEGIS-AI — AI Agent Red Team vs Blue Team Payment Security Lab
# ============================================================

# ---- OpenRouter API ----
# Required. Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Model names (both attacker and judge use the same model, different system prompts)
OPENROUTER_MODEL=stealth/ox-alpha

# ---- SQLite ----
# By default we use SQLite for portability since Docker isn't available.
DATABASE_URL=sqlite+aiosqlite:///aegis_ai.db
DATABASE_URL_SYNC=sqlite:///aegis_ai.db

# ---- PyRIT ----
PYRIT_LOG_LEVEL=INFO

# ---- Server ----
HOST=127.0.0.1
PORT=8000
